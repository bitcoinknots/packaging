#!/usr/bin/make -f
# -*- mode: makefile; coding: utf-8 -*-

#DEB_MAKE_CHECK_TARGET = test_bitcoin
#build/bitcoind::
#	$(if $(filter nocheck,$(DEB_BUILD_OPTIONS)),,src/test_bitcoin)

%:
	dh --with bash-completion --with systemd $@

override_dh_auto_clean:
	rm -rf build

EXTRA_CONF =
EXTRA_CONF += -DBUILD_GUI=ON
EXTRA_CONF += -DBUILD_UTIL=OFF
EXTRA_CONF += -DWITH_BDB=ON
EXTRA_CONF += -DWITH_MINIUPNPC=ON
EXTRA_CONF += -DWITH_USDT=ON
EXTRA_CONF += -DWITH_ZMQ=ON

ifeq ($(shell g++ -dumpversion),9)
	# Needed on Ubuntu focal to avoid buggy GCC 9
	# See also: https://gcc.gnu.org/bugzilla/show_bug.cgi?id=95189
	EXTRA_CONF += -DCMAKE_C_COMPILER=gcc-10 -DCMAKE_CXX_COMPILER=g++-10
endif
ifeq ($(shell g++ -dumpversion),7)
	# Needed on Ubuntu bionic to avoid unsupported GCC 7
	EXTRA_CONF += -DCMAKE_C_COMPILER=gcc-8 -DCMAKE_CXX_COMPILER=g++-8
endif

# Yea, autogen should be run on the source archive, but I like doing git archive
override_dh_auto_configure:
	cmake -B build $(EXTRA_CONF)
	xsltproc --novalid --nonet --path src/qt/res/src debian/flatten.xslt src/qt/res/src/bitcoin.svg > bitcoinknots.svg

override_dh_auto_build:
	CMAKE_BUILD_PARALLEL_LEVEL=2 \
	cmake --build build --verbose

override_dh_auto_install:
	DESTDIR="$(CURDIR)" \
	cmake --install build

override_dh_auto_test:
	ctest --test-dir build

# No SysV or Upstart init scripts included
override_dh_installinit:
	dh_installinit \
		--noscripts

# Don’t enable service by default
override_dh_systemd_enable:
	dh_systemd_enable \
		--no-enable

# Restart after upgrade
override_dh_systemd_start:
	dh_systemd_start \
		--restart-after-upgrade
